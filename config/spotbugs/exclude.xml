<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- FALSE POSITIVE: the record accessors hand out lists that the compact
         constructors made unmodifiable (List.copyOf, Stream.toList). SpotBugs
         cannot see that and reports every list component. -->
    <Match>
        <Or>
            <Class name="de.zettsystems.gamesplatform.api.MatchSummary"/>
            <Class name="de.zettsystems.gamesplatform.api.MatchEnded"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- Generated code. -->
    <Match>
        <Source name="~.*/build/generated/.*"/>
    </Match>

</FindBugsFilter>
